{{> topo}}

{{#if mensagem}}<p class="aviso" role="status">{{mensagem}}</p>{{/if}}

<h2>Cadastro de Itens</h2>
<form method="POST" action="/">
  {{> campos_item form}}
  <button type="submit">Cadastrar</button>
</form>

<h2>Itens Cadastrados</h2>
{{#if itens.length}}
  <p class="contagem">{{itens.length}} item(ns) cadastrado(s).</p>
  <ul>
    {{#each itens}}
      <li>
        {{#if imagemUrl}}<img src="{{imagemUrl}}" alt="Foto de {{nome}}" width="80">{{/if}}
        <strong>{{id}}</strong> — {{nome}} — {{status}} — {{#if local}}{{local}}{{else}}local não informado{{/if}}
        {{#if descricao}}<br><small>{{descricao}}</small>{{/if}}
        <br>
        <a href="/editar/{{id}}">Editar</a>
        <form method="POST" action="/deletar/{{id}}">
          <button type="submit">Excluir</button>
        </form>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="contagem">Nenhum item cadastrado.</p>
{{/if}}

{{> rodape}}
