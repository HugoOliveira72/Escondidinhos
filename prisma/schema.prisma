datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Item {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?
  local       String?
  imagemUrl   String?
  status      String   @default("perdido")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("itens")
}

model User {
  idUser    Int      @id @default(autoincrement())
  nome      String
  senha     String
  contato   String?
  tipoUser  Int      @default(0) // 0: Comum, 1: Administrador
  createdAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  @@map("Usuario")
}