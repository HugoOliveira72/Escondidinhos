<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'Cadê?' %>
  </title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <header>
    <h1>Cadê? <small>Achados e Perdidos</small></h1>
    <nav>
      <a href="/">Postagens</a>
      <% if (usuarioLogado) { %>
        <span>Logado como: <strong>
            <%= usuarioLogado.nome %>
          </strong></span>
        <a href="/usuarios/logout">Sair</a>
        <% } %>
    </nav>
    </nav>
  </header>

  <main>
    <% mensagens.forEach(function (m) { %>
      <p class="<%= m.tipo || 'aviso' %>" role="<%= m.tipo === 'erro' ? 'alert' : 'status' %>">
        <%= m.texto || m %>
      </p>
      <% }) %>

        <%- body %>
  </main>

  <footer>
    <p>© Projeto Interdisciplinar DSM 2026 - FATEC Porto Ferreira.</p>
  </footer>
</body>

</html>