
<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= typeof title !== 'undefined' ? title : 'Cadê?' %></title>

  <!-- Arquivos CSS disponibilizados pelo Express -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header>
    <h1>Cadê? <small>Achados e Perdidos</small></h1>
    <nav>
      <a href="/">Lista de Itens</a>
    </nav>
  </header>

  <main>

    <!-- Sistema de mensagens flash -->
    <% mensagens.forEach(function (m) { %>
      <p class="aviso" role="status"><%= m %></p>
    <% }) %>

    <!-- Conteúdo das páginas -->
    <%- body %>

  </main>

  <footer>
    <p>© Projeto Interdisciplinar DSM 2026 - FATEC Porto Ferreira.</p>
  </footer>

</body>
</html>
