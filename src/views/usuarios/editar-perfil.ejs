<div class="page-header-bar">
  <h2 class="page-title">Editar Meu Perfil</h2>
  <a href="/usuarios/perfil" class="btn btn-outline btn-sm">↩ Voltar ao Perfil</a>
</div>

<section class="surface-card" style="max-width: 600px;">
  <form method="post" action="/usuarios/perfil/editar" class="auth-form">
    <div class="form-group">
      <label for="nome">Nome Completo</label>
      <input type="text" id="nome" name="nome" value="<%= usuario.nome %>" required>
    </div>

    <div class="form-group">
      <label for="contato">E-mail ou Contato</label>
      <input type="text" id="contato" name="contato" value="<%= usuario.contato || '' %>">
    </div>

    <div class="form-group">
      <label for="senha">Nova Senha (deixe em branco para manter a atual)</label>
      <input type="password" id="senha" name="senha" placeholder="••••••••">
    </div>

    <div style="display: flex; gap: 10px; margin-top: 8px;">
      <button type="submit" class="btn btn-black">Salvar Alterações</button>
      <a href="/usuarios/perfil" class="btn btn-outline">Cancelar</a>
    </div>
  </form>
</section>