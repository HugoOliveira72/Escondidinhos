<h2>Cadastro de Itens</h2>

<% erros.forEach(function (e) { %><p class="erro" role="alert"><%= e %></p><% }) %>

<form method="post" action="/">
  <input name="nome" aria-label="Nome do item" placeholder="Nome do item" value="<%= form.nome || '' %>" required>
  <input name="descricao" aria-label="Descrição" placeholder="Descrição" value="<%= form.descricao || '' %>">
  <input name="local" aria-label="Local" placeholder="Local onde foi perdido/encontrado" value="<%= form.local || '' %>">
  <input name="imagemUrl" aria-label="URL da imagem" placeholder="URL da imagem" value="<%= form.imagemUrl || '' %>">
  <select name="status" aria-label="Status">
    <% STATUS.forEach(function (s) { %>
      <option value="<%= s %>" <%= (form.status || 'perdido') === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>
  <button type="submit">Cadastrar</button>
</form>

<h2>Itens Cadastrados</h2>

<% if (itens.length > 0) { %>
  <p class="contagem"><%= itens.length %> item(ns) cadastrado(s).</p>
  <ul>
    <% itens.forEach(function (i) { %>
      <li>
        <% if (i.imagemUrl) { %><img src="<%= i.imagemUrl %>" alt="Foto de <%= i.nome %>" width="80"><% } %>
        <strong><%= i.id %></strong> — <%= i.nome %> — <%= i.status %> — <%= i.local || 'local não informado' %>
        <% if (i.descricao) { %><br><small><%= i.descricao %></small><% } %>

        <!-- UPDATE: o id vai na URL (url_for('evento.editar', id=e.id) no Flask) -->
        <a href="/editar/<%= i.id %>">Editar</a>

        <!-- DELETE: sem link, precisa ser um formulário POST -->
        <form method="post" action="/deletar/<%= i.id %>" onsubmit="return confirm('Excluir este item?')">
          <button type="submit">Excluir</button>
        </form>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p class="contagem">Nenhum item cadastrado.</p>
<% } %>
