<%
  const ehAdmin = typeof usuarioLogado !== 'undefined' && usuarioLogado && usuarioLogado.tipo === 1;
  const totalPerdidos = postagens.filter(p => p.status === 'perdido').length;
  const totalEncontrados = postagens.filter(p => p.status === 'encontrado').length;
  const totalDevolvidos = postagens.filter(p => p.status === 'devolvido').length;
%>

<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-number"><%= totalDevolvidos %></div>
    <small>Itens Devolvidos</small>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= totalEncontrados %></div>
    <small>Itens Achados</small>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= totalPerdidos %></div>
    <small>Itens Perdidos</small>
  </div>
</div>

<% if (ehAdmin) { %>
  <section class="surface-card">
    <div class="page-header-bar">
      <h2 class="page-title">Nova Postagem</h2>
      <span class="page-subtitle">Cadastre o item e as informações da ocorrência</span>
    </div>

    <% erros.forEach(function (e) { %><p class="erro" role="alert"><%= e %></p><% }) %>

    <form method="post" action="/" enctype="multipart/form-data">
      <fieldset class="form-fieldset">
        <legend>Dados do Item</legend>

        <div class="form-grid-3">
          <div class="form-group">
            <label for="nome">Nome do item *</label>
            <input class="inputString" id="nome" name="nome" placeholder="Ex: Powerbank Branco" value="<%= form.nome || '' %>" required>
          </div>

          <div class="form-group">
            <label for="categoria">Categoria *</label>
            <select id="categoria" name="categoria" required>
              <option value="">Selecione a categoria...</option>
              <% CATEGORIAS.forEach(function (cat) { %>
                <option value="<%= cat %>" <%= form.categoria === cat ? 'selected' : '' %>><%= cat %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="cor">Cor</label>
            <input class="inputString" id="cor" name="cor" placeholder="Ex: Preto, Azul" value="<%= form.cor || '' %>">
          </div>
        </div>

        <div class="form-group" style="margin-top: 14px;">
          <label for="imagens">Fotos do item (selecione uma ou mais do computador, até 5):</label>
          <input
            type="file"
            id="imagens"
            name="imagens"
            accept="image/png, image/jpeg, image/webp, image/gif"
            multiple
          >
          <small class="page-subtitle">Formatos aceitos: JPG, PNG, WEBP ou GIF (máx. 5 MB cada).</small>
        </div>
      </fieldset>

      <fieldset class="form-fieldset">
        <legend>Dados da Postagem</legend>

        <div class="form-grid-3">
          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
              <% STATUS.forEach(function (s) { %>
                <option value="<%= s %>" <%= (form.status || 'perdido') === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="local">Local</label>
            <input class="inputString" id="local" name="local" placeholder="Ex: Cantina, Laboratório 2" value="<%= form.local || '' %>">
          </div>

          <div class="form-group">
            <label for="data_encontrado">Data que foi encontrado</label>
            <input type="date" id="data_encontrado" name="data_encontrado" value="<%= form.data_encontrado || '' %>">
          </div>
        </div>

        <div class="form-group" style="margin-top: 14px;">
          <label for="descricao">Descrição da postagem</label>
          <textarea id="descricao" name="descricao" rows="3" placeholder="Detalhes adicionais para identificação..."><%= form.descricao || '' %></textarea>
        </div>
      </fieldset>

      <button type="submit" class="btn btn-red">Publicar Postagem</button>
    </form>
  </section>
<% } %>

<div class="page-header-bar">
  <h2 class="page-title">Achados e Perdidos</h2>
  <span class="page-subtitle"><%= postagens.length %> postagem(ns) registrada(s)</span>
</div>

<% if (postagens.length > 0) { %>
  <div class="feed-grid" id="grid-postagens">
    <% postagens.forEach(function (p) { %>
      <%
        const fotos = (p.item && Array.isArray(p.item.imagens)) ? p.item.imagens : [];
        const capaUrl = fotos.length > 0 ? fotos[0].url : null;
        const termoBusca = [
          p.item ? p.item.nome : '',
          p.item ? p.item.categoria : '',
          p.item ? p.item.cor : '',
          p.local || '',
          p.status || ''
        ].join(' ').toLowerCase();
      %>
      <article class="post-card" data-busca="<%= termoBusca %>">
        <div class="post-cover">
          <% if (capaUrl) { %>
            <img src="<%= capaUrl %>" alt="Foto de <%= p.item ? p.item.nome : 'item' %>">
            <% if (fotos.length > 1) { %>
              <span class="post-photo-count">+<%= fotos.length - 1 %> foto(s)</span>
            <% } %>
          <% } else { %>
            <div class="post-cover-placeholder">
              🖼
              <span>Sem imagem</span>
            </div>
          <% } %>
        </div>

        <div class="post-body">
          <div class="post-header">
            <h3 class="post-title"><%= p.item ? p.item.nome : 'Item sem nome' %></h3>
            <span class="badge-status status-<%= p.status %>"><%= p.status %></span>
          </div>

          <div class="post-meta">
            <span class="meta-chip"><%= p.item ? p.item.categoria : '-' %></span>
            <% if (p.item && p.item.cor) { %>
              <span class="meta-chip">Cor: <%= p.item.cor %></span>
            <% } %>
            <% if (p.local) { %>
              <span class="meta-chip">📍 <%= p.local %></span>
            <% } %>
          </div>

          <% if (p.descricao) { %>
            <p class="post-desc"><%= p.descricao %></p>
          <% } %>

          <span class="post-date">
            Publicado em <%= new Date(p.data_publicacao).toLocaleString('pt-BR') %>
          </span>
        </div>

        <footer class="post-footer">
          <button
            type="button"
            class="btn btn-black btn-sm btn-ver-detalhes"
            aria-label="Ver detalhes da postagem #<%= p.id_postagem %>"
            data-postagem-id="<%= p.id_postagem %>"
          >
            👁️ Detalhes
          </button>

          <% if (ehAdmin) { %>
            <div class="post-admin-actions">
              <a href="/editar/<%= p.id_postagem %>" class="btn btn-outline btn-sm">Editar</a>
              <form method="post" action="/deletar/<%= p.id_postagem %>" style="display:inline;" onsubmit="return confirm('Excluir esta postagem e o item vinculado?')">
                <button type="submit" class="btn btn-red btn-sm">Excluir</button>
              </form>
            </div>
          <% } %>
        </footer>
      </article>
    <% }) %>
  </div>
<% } else { %>
  <div class="surface-card" style="text-align: center;">
    <p class="page-subtitle">Nenhuma postagem cadastrada até o momento.</p>
  </div>
<% } %>

<dialog id="modal-detalhes-postagem">
  <div class="modal-header-bar">
    <h3 id="modal-titulo-postagem">Detalhes da Postagem</h3>
    <button type="button" id="btn-fechar-detalhes-top" class="btn btn-black btn-sm">✕</button>
  </div>
  <div id="conteudo-detalhes-postagem" class="modal-body-content"></div>
  <div class="modal-footer-bar">
    <button type="button" id="btn-fechar-detalhes" class="btn btn-black">Fechar</button>
  </div>
</dialog>

<%
  const postagensSerializadas = postagens.map((p) => ({
    id_postagem: p.id_postagem,
    status: p.status,
    local: p.local || 'Não informado',
    descricao: p.descricao || 'Sem descrição.',
    data_publicacao: p.data_publicacao ? new Date(p.data_publicacao).toLocaleString('pt-BR') : '-',
    data_encontrado: p.data_encontrado ? new Date(p.data_encontrado).toLocaleDateString('pt-BR') : 'Não informada',
    item: p.item ? {
      nome: p.item.nome,
      categoria: p.item.categoria,
      cor: p.item.cor || 'Não informada',
      imagens: Array.isArray(p.item.imagens) ? p.item.imagens.map((img) => img.url) : []
    } : null
  }));
%>

<script>
  // Filtro dinâmico pela barra de busca do header
  const inputPesquisa = document.getElementById('filtro-pesquisa-global');
  if (inputPesquisa) {
    inputPesquisa.addEventListener('input', () => {
      const termo = inputPesquisa.value.trim().toLowerCase();
      document.querySelectorAll('#grid-postagens .post-card').forEach((card) => {
        const texto = card.getAttribute('data-busca') || '';
        card.style.display = texto.includes(termo) ? 'flex' : 'none';
      });
    });
  }

  const DADOS_POSTAGENS = <%- JSON.stringify(postagensSerializadas) %>;
  const dialogDetalhes = document.getElementById('modal-detalhes-postagem');
  const conteudoDetalhes = document.getElementById('conteudo-detalhes-postagem');
  const tituloModal = document.getElementById('modal-titulo-postagem');
  const btnFecharDetalhes = document.getElementById('btn-fechar-detalhes');
  const btnFecharTop = document.getElementById('btn-fechar-detalhes-top');

  function escaparHtml(texto) {
    return String(texto ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderizarDetalhes(p) {
    const item = p.item || {};
    const imagens = Array.isArray(item.imagens) ? item.imagens : [];
    tituloModal.textContent = `Detalhes da Postagem #${p.id_postagem}`;

    const htmlImagens = imagens.length > 0
      ? `<div>
           <p><strong>Fotos do item:</strong></p>
           <div class="modal-gallery">
             ${imagens.map((url, idx) => `
               <a href="${escaparHtml(url)}" target="_blank" rel="noopener">
                 <img src="${escaparHtml(url)}" alt="Foto ${idx + 1} de ${escaparHtml(item.nome || 'item')}">
               </a>
             `).join('')}
           </div>
         </div>`
      : '<p><strong>Fotos do item:</strong> Nenhuma foto anexada.</p>';

    conteudoDetalhes.innerHTML = `
      <fieldset class="form-fieldset" style="margin-bottom:0;">
        <legend>Dados do Item</legend>
        <p><strong>Nome:</strong> ${escaparHtml(item.nome || '-')}</p>
        <p><strong>Categoria:</strong> ${escaparHtml(item.categoria || '-')}</p>
        <p><strong>Cor:</strong> ${escaparHtml(item.cor)}</p>
        ${htmlImagens}
      </fieldset>

      <fieldset class="form-fieldset" style="margin-bottom:0;">
        <legend>Dados da Postagem</legend>
        <p><strong>Status:</strong> <span class="badge-status status-${escaparHtml(p.status)}">${escaparHtml(p.status)}</span></p>
        <p><strong>Local:</strong> ${escaparHtml(p.local)}</p>
        <p><strong>Data da publicação:</strong> ${escaparHtml(p.data_publicacao)}</p>
        <p><strong>Data que foi encontrado:</strong> ${escaparHtml(p.data_encontrado)}</p>
        <p><strong>Descrição:</strong> ${escaparHtml(p.descricao)}</p>
      </fieldset>
    `;
  }

  if (dialogDetalhes && conteudoDetalhes) {
    document.querySelectorAll('.btn-ver-detalhes').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = Number(btn.getAttribute('data-postagem-id'));
        const postagem = DADOS_POSTAGENS.find((item) => item.id_postagem === id);
        if (!postagem) return;

        renderizarDetalhes(postagem);
        if (typeof dialogDetalhes.showModal === 'function') {
          dialogDetalhes.showModal();
        } else {
          dialogDetalhes.setAttribute('open', '');
        }
      });
    });

    [btnFecharDetalhes, btnFecharTop].forEach((b) => {
      if (b) b.addEventListener('click', () => dialogDetalhes.close());
    });

    dialogDetalhes.addEventListener('click', (evento) => {
      if (evento.target === dialogDetalhes) {
        dialogDetalhes.close();
      }
    });
  }
</script>