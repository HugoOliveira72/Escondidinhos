<% const ehAdmin = typeof usuarioLogado !== 'undefined' && usuarioLogado && usuarioLogado.tipo === 1; %>

<% if (ehAdmin) { %>
  <section class="card-publicar">
    <h2>Nova Postagem</h2>

    <% erros.forEach(function (e) { %><p class="erro" role="alert"><%= e %></p><% }) %>

    <form method="post" action="/">
      <fieldset style="border: 1px solid #ccc; padding: .75rem; border-radius: 6px; margin-bottom: .75rem;">
        <legend><strong>Dados do Item</strong></legend>
        <input name="nome" aria-label="Nome do item" placeholder="Nome do item" value="<%= form.nome || '' %>" required>

        <select name="categoria" aria-label="Categoria" required>
          <option value="">Selecione a categoria...</option>
          <% CATEGORIAS.forEach(function (cat) { %>
            <option value="<%= cat %>" <%= form.categoria === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>

        <input name="cor" aria-label="Cor do item" placeholder="Cor (ex: Preto, Azul)" value="<%= form.cor || '' %>">

        <div id="lista-fotos-item" style="margin-top: .5rem;">
          <label><strong>Fotos do item (URLs):</strong></label>
          <% const fotosForm = Array.isArray(form.imagens) ? form.imagens : (form.imagens ? [form.imagens] : ['']); %>
          <% fotosForm.forEach(function (url) { %>
            <div class="campo-foto" style="margin-top: .3rem;">
              <input type="url" name="imagens[]" placeholder="https://exemplo.com/foto.jpg" value="<%= url %>" style="width: 80%;">
            </div>
          <% }) %>
        </div>

        <button type="button" id="btn-add-foto-item" style="margin-top: .4rem;">+ Adicionar outra foto</button>
      </fieldset>

      <fieldset style="border: 1px solid #ccc; padding: .75rem; border-radius: 6px; margin-bottom: .75rem;">
        <legend><strong>Dados da Postagem</strong></legend>

        <select name="status" aria-label="Status">
          <% STATUS.forEach(function (s) { %>
            <option value="<%= s %>" <%= (form.status || 'perdido') === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>

        <input name="local" aria-label="Local" placeholder="Local" value="<%= form.local || '' %>">

        <label for="data_encontrado">Data que foi encontrado:</label>
        <input type="date" id="data_encontrado" name="data_encontrado" value="<%= form.data_encontrado || '' %>">

        <div style="margin-top: .5rem;">
          <textarea name="descricao" rows="3" style="width: 100%;" placeholder="Descrição da postagem..."><%= form.descricao || '' %></textarea>
        </div>
      </fieldset>

      <button type="submit">Publicar Postagem</button>
    </form>
  </section>
<% } %>

<h2>Postagens</h2>

<% if (postagens.length > 0) { %>
  <p class="contagem"><%= postagens.length %> postagem(ns) cadastrada(s).</p>

  <% postagens.forEach(function (p) { %>
    <article class="post-card">
      <header class="post-cabecalho">
        <div>
          <strong>#<%= p.id_postagem %> — <%= p.item ? p.item.nome : 'Item sem nome' %></strong>
          <span class="badge-status status-<%= p.status %>"><%= p.status.toUpperCase() %></span>
        </div>
        <small>Publicado em: <%= new Date(p.data_publicacao).toLocaleString('pt-BR') %></small>
      </header>

      <p>
        <strong>Categoria:</strong> <%= p.item ? p.item.categoria : '-' %>
        <% if (p.item && p.item.cor) { %> | <strong>Cor:</strong> <%= p.item.cor %><% } %>
        <% if (p.local) { %> | <strong>Local:</strong> <%= p.local %><% } %>
      </p>

      <% if (p.data_encontrado) { %>
        <p><strong>Data que foi encontrado:</strong> <%= new Date(p.data_encontrado).toLocaleDateString('pt-BR') %></p>
      <% } %>

      <% if (p.descricao) { %>
        <p><%= p.descricao %></p>
      <% } %>

      <% if (p.item && p.item.imagens && p.item.imagens.length > 0) { %>
        <div class="post-galeria">
          <% p.item.imagens.forEach(function (img, idx) { %>
            <a href="<%= img.url %>" target="_blank" rel="noopener">
              <img src="<%= img.url %>" alt="Foto <%= idx + 1 %> de <%= p.item.nome %>">
            </a>
          <% }) %>
        </div>
      <% } %>

      <button
        type="button"
        class="btn-ver-detalhes"
        aria-label="Ver detalhes da postagem #<%= p.id_postagem %>"
        data-postagem-id="<%= p.id_postagem %>"
      >
        👁️ Detalhes
      </button>

      <% if (ehAdmin) { %>
        <footer class="post-rodape">
          <a href="/editar/<%= p.id_postagem %>">Editar</a>
          <form method="post" action="/deletar/<%= p.id_postagem %>" style="display:inline;" onsubmit="return confirm('Excluir esta postagem e o item vinculado?')">
            <button type="submit">Excluir</button>
          </form>
        </footer>
      <% } %>
    </article>
  <% }) %>
<% } else { %>
  <p class="contagem">Nenhuma postagem cadastrada.</p>
<% } %>

<script>
  const btnAddFotoItem = document.getElementById('btn-add-foto-item');
  if (btnAddFotoItem) {
    btnAddFotoItem.addEventListener('click', () => {
      const container = document.getElementById('lista-fotos-item');
      const div = document.createElement('div');
      div.className = 'campo-foto';
      div.style.marginTop = '.3rem';
      div.innerHTML = '<input type="url" name="imagens[]" placeholder="https://exemplo.com/outra-foto.jpg" style="width: 80%;"> <button type="button" onclick="this.parentElement.remove()">Remover</button>';
      container.appendChild(div);
    });
  }
</script>


<dialog id="modal-detalhes-postagem">
  <div id="conteudo-detalhes-postagem"></div>
  <button type="button" id="btn-fechar-detalhes">Fechar</button>
</dialog>

<%
  const postagensSerializadas = postagens.map((p) => ({
    id_postagem: p.id_postagem,
    status: p.status,
    local: p.local || 'Não informado',
    descricao: p.descricao || 'Sem descrição.',
    data_publicacao: p.data_publicacao ? new Date(p.data_publicacao).toLocaleString('pt-BR') : '-',
    data_encontrado: p.data_encontrado ? new Date(p.data_encontrado).toLocaleDateString('pt-BR') : 'Não informada',
    item: p.item ? {
      nome: p.item.nome,
      categoria: p.item.categoria,
      cor: p.item.cor || 'Não informada',
      imagens: Array.isArray(p.item.imagens) ? p.item.imagens.map((img) => img.url) : []
    } : null
  }));
%>

<script>
  const DADOS_POSTAGENS = <%- JSON.stringify(postagensSerializadas) %>;
  const dialogDetalhes = document.getElementById('modal-detalhes-postagem');
  const conteudoDetalhes = document.getElementById('conteudo-detalhes-postagem');
  const btnFecharDetalhes = document.getElementById('btn-fechar-detalhes');

  function escaparHtml(texto) {
    return String(texto ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderizarDetalhes(p) {
    const item = p.item || {};
    const imagens = Array.isArray(item.imagens) ? item.imagens : [];

    const htmlImagens = imagens.length > 0
      ? `<div>
           <p><strong>Fotos do item:</strong></p>
           <div>
             ${imagens.map((url, idx) => `
               <a href="${escaparHtml(url)}" target="_blank" rel="noopener">
                 <img src="${escaparHtml(url)}" alt="Foto ${idx + 1} de ${escaparHtml(item.nome || 'item')}" width="150">
               </a>
             `).join('')}
           </div>
         </div>`
      : '<p><strong>Fotos do item:</strong> Nenhuma foto anexada.</p>';

    conteudoDetalhes.innerHTML = `
      <h3>Detalhes da Postagem #${escaparHtml(p.id_postagem)}</h3>

      <fieldset>
        <legend><strong>Dados do Item</strong></legend>
        <p><strong>Nome:</strong> ${escaparHtml(item.nome || '-')}</p>
        <p><strong>Categoria:</strong> ${escaparHtml(item.categoria || '-')}</p>
        <p><strong>Cor:</strong> ${escaparHtml(item.cor)}</p>
        ${htmlImagens}
      </fieldset>

      <fieldset>
        <legend><strong>Dados da Postagem</strong></legend>
        <p><strong>Status:</strong> ${escaparHtml(p.status)}</p>
        <p><strong>Local:</strong> ${escaparHtml(p.local)}</p>
        <p><strong>Data da publicação:</strong> ${escaparHtml(p.data_publicacao)}</p>
        <p><strong>Data que foi encontrado:</strong> ${escaparHtml(p.data_encontrado)}</p>
        <p><strong>Descrição:</strong> ${escaparHtml(p.descricao)}</p>
      </fieldset>
    `;
  }

  if (dialogDetalhes && conteudoDetalhes && btnFecharDetalhes) {
    document.querySelectorAll('.btn-ver-detalhes').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = Number(btn.getAttribute('data-postagem-id'));
        const postagem = DADOS_POSTAGENS.find((item) => item.id_postagem === id);
        if (!postagem) return;

        renderizarDetalhes(postagem);
        if (typeof dialogDetalhes.showModal === 'function') {
          dialogDetalhes.showModal();
        } else {
          dialogDetalhes.setAttribute('open', '');
        }
      });
    });

    btnFecharDetalhes.addEventListener('click', () => {
      dialogDetalhes.close();
    });

    dialogDetalhes.addEventListener('click', (evento) => {
      if (evento.target === dialogDetalhes) {
        dialogDetalhes.close();
      }
    });
  }
</script>