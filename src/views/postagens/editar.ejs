<div class="page-header-bar">
  <h2 class="page-title">Editar Postagem #<%= postagem.id_postagem %></h2>
  <a href="/" class="btn btn-outline btn-sm">↩ Voltar ao Feed</a>
</div>

<section class="surface-card">
  <% erros.forEach(function (e) { %><p class="erro" role="alert"><%= e %></p><% }) %>

  <%
    const dataEncontradaFormatada = postagem.data_encontrado
      ? new Date(postagem.data_encontrado).toISOString().split('T')[0]
      : '';
  %>

  <form method="post" action="/editar/<%= postagem.id_postagem %>">
    <fieldset class="form-fieldset">
      <legend>Dados do Item</legend>

      <div class="form-grid-3">
        <div class="form-group">
          <label for="nome">Nome do item *</label>
          <input id="nome" name="nome" value="<%= postagem.item ? postagem.item.nome : '' %>" required>
        </div>

        <div class="form-group">
          <label for="categoria">Categoria *</label>
          <select id="categoria" name="categoria" required>
            <option value="">Selecione a categoria...</option>
            <% CATEGORIAS.forEach(function (cat) { %>
              <option value="<%= cat %>" <%= (postagem.item && postagem.item.categoria === cat) ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="cor">Cor</label>
          <input id="cor" name="cor" value="<%= postagem.item ? (postagem.item.cor || '') : '' %>">
        </div>
      </div>

      <% const fotosAtuais = (postagem.item && Array.isArray(postagem.item.imagens)) ? postagem.item.imagens : []; %>
      <% if (fotosAtuais.length > 0) { %>
        <div style="margin-top: 14px;">
          <label style="font-size: 0.92rem; font-weight: 600;">Fotos atuais:</label>
          <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px;">
            <% fotosAtuais.forEach(function (img, idx) { %>
              <img
                src="<%= img.url %>"
                alt="Foto atual <%= idx + 1 %>"
                style="width: 84px; height: 84px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd;"
              >
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="form-group" style="margin-top: 14px;">
        <label for="imagens">Substituir fotos do item (opcional, até 5):</label>
        <input
          type="file"
          id="imagens"
          name="imagens"
          accept="image/png, image/jpeg, image/webp, image/gif"
          multiple
        >
        <small class="page-subtitle">Deixe em branco para manter as fotos atuais.</small>
      </div>
    </fieldset>

    <fieldset class="form-fieldset">
      <legend>Dados da Postagem</legend>

      <div class="form-grid-3">
        <div class="form-group">
          <label for="status">Status</label>
          <select id="status" name="status">
            <% STATUS.forEach(function (s) { %>
              <option value="<%= s %>" <%= postagem.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="local">Local</label>
          <input id="local" name="local" value="<%= postagem.local || '' %>">
        </div>

        <div class="form-group">
          <label for="data_encontrado">Data que foi encontrado</label>
          <input type="date" id="data_encontrado" name="data_encontrado" value="<%= dataEncontradaFormatada %>">
        </div>
      </div>

      <div class="form-group" style="margin-top: 14px;">
        <label for="descricao">Descrição da postagem</label>
        <textarea id="descricao" name="descricao" rows="3"><%= postagem.descricao || '' %></textarea>
      </div>
    </fieldset>

    <div style="display: flex; gap: 10px;">
      <button type="submit" class="btn btn-black">Salvar Alterações</button>
      <a href="/" class="btn btn-outline">Cancelar</a>
    </div>
  </form>
</section>